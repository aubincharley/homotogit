# datasets are external (see README: CIFAR-10 python batches, STL-10 binaries)
/data/
# training outputs and checkpoints
/runs/
*.pt
*.npz
# ...except the pinned reference assets, which are versioned with their hashes
!/assets/**/*.pt
!/assets/**/*.npz
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Generated Kaggle job bundles (base64 payload, regenerable by tools/kaggle_run.py)
/kaggle_jobs/
# Kaggle downloads: keep the scientific record (configs, metrics, summaries,
# probe outputs and figures), drop the bulky regenerable parts.
results/kaggle_outputs/**/_repo/
results/kaggle_outputs/**/*.log
